+});
+
+test('hidden and inactive targets stay protected, and brush OnHit callbacks do not receive splash',()=>{
+  const {game,crate}=fixture([entity('MovingEnemy','hidden',{Type:'5'}),entity('MovingEnemy','inactive',{Type:'5'}),entity('ModelController','brush',{OnHitCommand:'crate.show'})]);
+  game.find('hidden')[0].visible=false;game.find('inactive')[0].enabled=false;
+  game.destroy(crate);advance(game,.6);
+  assert.equal(game.find('hidden')[0].health,3);assert.equal(game.find('inactive')[0].health,3);assert.equal(game.find('brush')[0].health,1);
+});
+
+test('player death fires once; noclip immunity and cutscene protection remain intact',()=>{
+  const dead=fixture();dead.game.destroy(dead.crate);advance(dead.game,.4,[0,0,0]);
+  assert.equal(dead.game.state.health,0);assert.equal(dead.game.state.lives,2);assert.equal(dead.events.filter(event=>event.type==='death').length,1);
+  const immune=fixture();immune.game.isPlayerInvulnerable=()=>true;immune.game.destroy(immune.crate);advance(immune.game,.5,[0,0,0]);assert.equal(immune.game.state.health,10);
+  const cutscene=fixture();cutscene.game.destroy(cutscene.crate);cutscene.game.scripts={cutscene:true};
+  advance(cutscene.game,.5,[0,0,0]);cutscene.game.scripts.cutscene=false;advance(cutscene.game,.1,[0,0,0]);assert.equal(cutscene.game.state.health,10);
+});
+
+test('saving mid-blast resumes only remaining damage and respawn clears pending damage',()=>{
+  const {game,crate,level}=fixture();game.state.health=game.state.maxHealth=20;game.destroy(crate);advance(game,.1,[87.5,0,0]);
+  const save=JSON.parse(JSON.stringify(game.snapshot())),events=[],restored=new Gameplay(level,{save,onEvent:event=>events.push(event)});
+  assert.equal(restored.explosions.length,1);assert.equal(restored.explosions[0].birth,save.explosions[0].birth);
+  let sprites=0;
+  new DestructibleEffects({},restored).update(0,new Map([['explosie02.bmp|explosie02_a.bmp',{add:()=>sprites++}]]));
+  assert.equal(sprites,1,'the saved active blast is rendered at its original age');
+  assert.equal(events.filter(event=>event.type==='scriptSound').length,0,'loading never replays the explosion sound');
+  restored.updateEnemy=()=>{};restored.objects[0].actorSettings=settings('brcrate');restored.destroy(restored.objects[0]);
+  assert.equal(restored.explosionDamage.length,1);assert.equal(restored.explosionDamage[0].activatedAt,.1);
+  advance(game,.5,[87.5,0,0]);advance(restored,.5,[87.5,0,0]);
+  near(restored.state.health,game.state.health);near(restored.state.health,8.28125);
+  assert.equal(new Gameplay(level,{save:restored.snapshot()}).explosionDamage.length,0);
+  assert.equal(new Gameplay(level,{save:restored.snapshot()}).explosions.length,1,'the longer visual tail remains saved without renewing damage');
+  restored.explosionDamage=save.explosionDamage;restored.respawn();assert.equal(restored.explosionDamage.length,0);
+});
+
+test('a synchronous respawn during blast damage discards the old cell iteration immediately',()=>{
+  const {game,crate}=fixture([entity('MovingEnemy','enemy',{Type:'5'})]);
+  game.destroy(crate);game.explosionDamage.push({...game.explosionDamage[0],sourceId:'other-crate'});
+  game.state.health=.1;let hits=0;
+  game.onEvent=event=>{
+    if(event.type==='damage')hits++;
+    if(event.type==='death'){game.respawn();game.playerReaction=null;}
+  };
+  advance(game,.1,[0,0,0]);
+  assert.equal(game.state.health,10);assert.equal(game.state.lives,2);assert.equal(hits,1);
+  assert.equal(game.explosionDamage.length,0);assert.equal(game.find('enemy')[0].health,3);
+});
+
+test('delayed blasts arm on the first eligible frame and do not clip that frame or the inclusive end',()=>{
+  const {game}=fixture();game.state.health=game.state.maxHealth=20;
+  game.explosionDamage=[{sourceId:'gone',birth:.15,position:[0,54.08,0],radius:175,rate:2}];
+  game.time=.1;advanceExplosionDamage(game,.1,[0,0,0]);assert.equal(game.state.health,20);
+  game.time=.2;advanceExplosionDamage(game,.1,[0,0,0]);near(game.state.health,19.8);
+  assert.equal(game.explosionDamage[0].activatedAt,.2);
+  game.time=.6;advanceExplosionDamage(game,.4,[0,0,0]);near(game.state.health,19);
+  assert.equal(game.explosionDamage.length,1,'the exact endpoint is still live');
+  game.time=.601;advanceExplosionDamage(game,.001,[0,0,0]);near(game.state.health,19);assert.equal(game.explosionDamage.length,0);
+});
+
+test('the first frame beyond expiry does not receive a clipped remainder',()=>{
+  const {game}=fixture();game.state.health=game.state.maxHealth=20;
+  game.explosionDamage=[{sourceId:'gone',birth:0,activatedAt:.1,position:[0,54.08,0],radius:175,rate:2}];
+  game.time=.48;advanceExplosionDamage(game,.08,[0,0,0]);near(game.state.health,19.84);
+  game.time=.55;advanceExplosionDamage(game,.07,[0,0,0]);near(game.state.health,19.84);
+  assert.equal(game.explosionDamage.length,0);
+});
+
+test('pending saves preserve first activation, old saves retain their original expiry, and bad clocks are rejected',()=>{
+  const cell={sourceId:'gone',birth:2,position:[0,54.08,0],radius:175,rate:2};
+  assert.equal(restoreExplosionDamage([{...cell,activatedAt:null}],2.1)[0].activatedAt,null);
+  assert.equal(restoreExplosionDamage([cell],2.1)[0].activatedAt,2,'old active cells do not restart');
+  assert.equal(restoreExplosionDamage([cell],1.9)[0].activatedAt,null,'old future cells still wait');
+  assert.deepEqual(restoreExplosionDamage([cell],2.5),[],'old expired cells never resurrect');
+  for(const activatedAt of [1,3,Infinity,'2.1'])assert.deepEqual(restoreExplosionDamage([{...cell,activatedAt}],2.2),[]);
+  const {game}=fixture();game.state.health=game.state.maxHealth=20;
+  game.explosionDamage=restoreExplosionDamage([{...cell,activatedAt:null}],2.1);
+  game.time=2.2;advanceExplosionDamage(game,.1,[0,0,0]);near(game.state.health,19.8);
+  assert.equal(game.explosionDamage[0].activatedAt,2.2);
+});
+
+test('world explosion targets expose rendered bounds for rotated, scaled moving actors',()=>{
+  const {game,crate}=fixture(),actor=new THREE.Group(),geometry=new THREE.BoxGeometry(10,20,30),material=new THREE.MeshBasicMaterial(),mesh=new THREE.Mesh(geometry,material);
+  actor.add(mesh);actor.userData.mesh=mesh;geometry.computeBoundingBox();mesh.scale.set(2,3,4);crate.kind='enemy';crate.yaw=Math.PI/2;crate.position=[100,20,200];
+  CastleWorld.prototype.configureExplosionTarget.call({gameplay:game},crate,actor);
+  const bounds=crate.explosionBounds();
+  assert.deepEqual(bounds.origin,[100,20,200]);
+  for(let axis=0;axis<3;axis++){near(bounds.min[axis],[40,-10,190][axis]);near(bounds.max[axis],[160,50,210][axis]);}
+  crate.position[0]+=50;near(crate.explosionBounds().min[0],90,'same-tick relocation invalidates bounds');
+  assert.equal(crate.explosionMayReach({position:[90,20,200],radius:1}),true,'broadphase retains a nearby edge even with distant actor origin');
+  assert.equal(crate.explosionMayReach({position:[10000,20,200],radius:175}),false,'far actor does not need posed world bounds');
+  geometry.dispose();material.dispose();
+});
diff --git a/tests/explosion-tail-save.test.mjs b/tests/explosion-tail-save.test.mjs
new file mode 100644
index 00000000..cc03e50d
--- /dev/null
+++ b/tests/explosion-tail-save.test.mjs
@@ -0,0 +1,59 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import * as THREE from 'three';
+import {Gameplay} from '../src/gameplay.js';
+import {DestructibleEffects} from '../src/destructible-effects.js';
+import {createNativeExplosionDamage,advanceExplosionDamage} from '../src/explosion-damage.js';
+import {createNativeDebris,stepNativeDebris} from '../src/debris-native.js';
+
+test('saving after damage expires retains the visible smoke tail without restarting damage or sound',()=>{
+  const level={id:'explosion-tail-save',entities:[]},game=new Gameplay(level),events=[];
+  const effect={id:'crate:0',sourceId:'crate',birth:0,position:[0,54.08,0],
+    settings:{explosion:{NrExplosions:1,SizePercentage:25,DamagePercentage:25,SmokeOnly:true}}};
+  game.explosions=[effect];game.explosionDamage=createNativeExplosionDamage(effect);
+  for(const time of [.1,.2,.3,.4,.5,.6,1]){
+    game.time=time;advanceExplosionDamage(game,.1,[1000,0,0]);
+  }
+  assert.equal(game.explosionDamage.length,0);
+  const draw=g=>{
+    const sprites=[],renderer=new DestructibleEffects({},g);
+    renderer.update(0,new Map([['smoke_05.bmp|smoke_green_a.bmp',{add:(...args)=>sprites.push(structuredClone(args))}]]));
+    return sprites;
+  };
+  const before=draw(game);assert.ok(before.length>0,'the original smoke tail is still visible');
+  const save=JSON.parse(JSON.stringify(game.snapshot()));
+  assert.equal(save.explosions.length,1);assert.equal(save.explosionDamage.length,0);
+  const restored=new Gameplay(level,{save,onEvent:event=>events.push(event)});
+  assert.deepEqual(draw(restored),before,'restored smoke resumes at its saved age');
+  assert.equal(restored.explosionDamage.length,0);assert.equal(events.length,0);
+  const health=restored.state.health;
+  restored.update(.1,[0,0,0]);assert.equal(restored.state.health,health,'standing in the old blast cannot renew its damage');
+  assert.equal(restored.explosionDamage.length,0);
+  restored.time=6.1;assert.deepEqual(restored.snapshot().explosions,[],'finished effect records still expire');
+});
+
+test('restored prop fragments resume their saved age instead of relaunching with the smoke tail',()=>{
+  const effect={id:'crate:0',sourceId:'crate',birth:0,position:[0,50,0],settings:{debris:{types:[
+    {actor:'chunk.act',MinNr:1,MaxNr:1,MinVelocity:10,MaxVelocity:10}
+  ]}}};
+  const conf={MinLifeTimeSeconds:1,MaxLifeTimeSeconds:1,Gravity:1,TestCollision:1,MustRotate:1,RotationSpeed:100,AirFriction:1};
+  const settings={debris:conf},trace=(_a,end)=>({fraction:1,end});
+  const make=time=>{
+    const game={time,explosions:[effect]},world={scene:new THREE.Scene(),physicalModels:[],collider:{trace}};
+    const renderer=new DestructibleEffects(world,game),mesh=new THREE.Mesh(new THREE.BufferGeometry(),new THREE.MeshBasicMaterial());
+    const prototype=new THREE.Group();prototype.userData={mesh,template:{data:{settings}}};
+    renderer.prototypes.set('chunk',prototype);return{game,world,renderer,mesh};
+  };
+  const expected=createNativeDebris(effect,()=>settings)[0];
+  while(expected.age<.6-1e-8)stepNativeDebris(expected,Math.min(.05,.6-expected.age),trace);
+  const loaded=make(.6);loaded.renderer.update(.02,new Map());
+  assert.equal(loaded.renderer.particles.length,1);
+  const particle=loaded.renderer.particles[0];
+  assert.equal(particle.age,.6,'first rendering does not add the frame delta twice');
+  assert.deepEqual(particle.position,expected.position);assert.deepEqual(particle.orientation,expected.orientation);
+  loaded.game.time=.62;loaded.renderer.update(.02,new Map());assert.equal(particle.age,.62);
+  const expired=make(2);expired.renderer.update(0,new Map());
+  assert.equal(expired.renderer.particles.length,0);assert.equal(expired.world.scene.children.length,0,'expired fragments never reappear');
+  const fresh=make(0);fresh.renderer.update(.02,new Map());assert.equal(fresh.renderer.particles[0].age,.02,'fresh launches retain their existing integration');
+  for(const fixture of [loaded,expired,fresh]){fixture.renderer.dispose();fixture.mesh.geometry.dispose();fixture.mesh.material.dispose();}
+});
diff --git a/tests/fairy-idle-audio-scenes.mjs b/tests/fairy-idle-audio-scenes.mjs
new file mode 100644
index 00000000..cdda0372
--- /dev/null
+++ b/tests/fairy-idle-audio-scenes.mjs
@@ -0,0 +1,46 @@
+// Check actual original PCM through the spatial mixer across repeated seams.
+// Isolated browser storage and all retained artifacts stay under temp_work.
+import {chromium} from 'playwright';
+import {spawn} from 'node:child_process';
+import {mkdir,writeFile} from 'node:fs/promises';
+import path from 'node:path';
+import assert from 'node:assert/strict';
+
+const out=path.resolve(`temp_work/fairy-idle-audio-${Date.now()}`);
+await mkdir(out,{recursive:true});await mkdir('temp_work/fairy-audio-tmp',{recursive:true});
+await writeFile(out+'/harness.html','<!doctype html><base href="/"><title>Fairy idle audio check</title>');
+const server=spawn(process.execPath,['tools/serve.mjs'],{env:{...process.env,PORT:'0'},stdio:['ignore','pipe','inherit']});
+let browser;
+try {
+  const url=await new Promise((resolve,reject)=>{server.stdout.once('data',data=>resolve(String(data).trim().split(' ').at(-1)));server.once('error',reject);});
+  browser=await chromium.launchPersistentContext(out+'/profile',{executablePath:process.env.CHROME_PATH||'/usr/bin/google-chrome',headless:true,
+    env:{...process.env,TMPDIR:'temp_work/fairy-audio-tmp'}});
+  const page=await browser.newPage(),errors=[];page.on('pageerror',error=>errors.push(error.stack));
+  await page.goto(url+'/'+path.relative(process.cwd(),out)+'/harness.html');
+  const results=await page.evaluate(async()=>{
+    const {GameAudio,nativeGainToAmplitude}=await import('/src/audio.js');const results=[];
+    for(const rate of [44100,48000]){
+      const frames=Math.floor(89836*rate/44100),offline=new OfflineAudioContext(2,frames*4+256,rate),sources=[];
+      const context={state:'running',get currentTime(){return offline.currentTime;},destination:offline.destination,
+        createGain:()=>offline.createGain(),createChannelSplitter:n=>offline.createChannelSplitter(n),createChannelMerger:n=>offline.createChannelMerger(n),
+        decodeAudioData:bytes=>offline.decodeAudioData(bytes),createBufferSource:()=>{const source=offline.createBufferSource();sources.push(source);return source;}};
+      const audio=new GameAudio({master:1,createContext:()=>context});audio.setLevel('lvl01a');audio.setPlayerListener([0,0,0]);
+      const r=audio.play({sound:'IdleFee1.wav',loop:true,spatial:true,position:[0,0,0]});await r.element.play();
+      if(!r.element.nativeBuffered)throw new Error('Fairy still uses HTML media');
+      let ends=0;const ended=sources[0].onended;sources[0].onended=()=>{ends++;ended?.();};
+      const decoded=r.element.buffer,rendered=await offline.startRendering(),expected=decoded.getChannelData(0),gain=nativeGainToAmplitude(.4);
+      let mismatches=0,maxError=0;
+      for(let ch=0;ch<2;ch++){
+        const actual=rendered.getChannelData(ch);
+        for(let i=0;i<actual.length;i++){
+          const error=Math.abs(actual[i]-expected[i%expected.length]*gain);maxError=Math.max(maxError,error);if(error>1e-6)mismatches++;
+        }
+      }
+      results.push({rate,frames:decoded.length,renderedFrames:rendered.length,gain:r.element.volume,sources:sources.length,ends,maxError,mismatches});audio.reset();
+    }
+    return results;
+  });
+  await writeFile(out+'/report.json',JSON.stringify({results,errors},null,2)+'\n');
+  for(const r of results){assert.equal(r.frames,Math.floor(89836*r.rate/44100));assert.equal(r.sources,1);assert.equal(r.ends,0);assert.equal(r.mismatches,0);}
+  assert.deepEqual(errors,[]);console.log('PASS original fairy PCM at 44.1/48 kHz: four seamless wraps, both stereo channels, native idle gain, one continuous source.');console.log(out);
+}finally{await browser?.close();server.kill();}
diff --git a/tests/fairy-idle-audio.test.mjs b/tests/fairy-idle-audio.test.mjs
new file mode 100644
index 00000000..79241adc
--- /dev/null
+++ b/tests/fairy-idle-audio.test.mjs
@@ -0,0 +1,71 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {GameAudio,nativeGainToAmplitude} from '../src/audio.js';
+
+const settle=()=>new Promise(resolve=>setImmediate(resolve));
+const duration=89836/44100;
+const idle={sound:'IdleFee1.wav',key:'effect:fairy:Fairy1:idlefee1.wav',sourceId:'fairy:Fairy1:idlefee1.wav',loop:true,spatial:true,position:[0,0,0]};
+const near=(a,b)=>assert.ok(Math.abs(a-b)<1e-8,`${a} != ${b}`);
+function harness({available=true,pending=false}={}) {
+  const sources=[],media=[],requests=[];let finish;
+  const node=()=>({gain:{value:1},connect(){},disconnect(){this.disconnected=true;}});
+  const context={currentTime:0,state:'running',destination:node(),createGain:node,
+    createChannelSplitter:node,createChannelMerger:node,createMediaElementSource:node,
+    decodeAudioData:async()=>({duration}),resume:async()=>{},
+    createBufferSource(){const source={...node(),playbackRate:{value:1},start(time,offset){this.offset=offset;},stop(){this.stopped=true;}};sources.push(source);return source;}};
+  const response={ok:true,arrayBuffer:async()=>new ArrayBuffer(8)};
+  const audio=new GameAudio({master:1,createContext:()=>available?context:null,
+    fetchAudio:url=>{requests.push(url);return pending?new Promise(resolve=>{finish=()=>resolve(response);}):Promise.resolve(response);},
+    createAudio:url=>{const element={src:url,paused:true,currentTime:0,readyState:4,play(){this.paused=false;return Promise.resolve();},pause(){this.paused=true;},removeAttribute(){this.src=null;},load(){}};media.push(element);return element;}});
+  audio.setLevel('lvl01a');audio.setPlayerListener([0,0,0]);
+  return {audio,context,sources,media,requests,finish:()=>finish()};
+}
+
+test('fairy idle uses one complete original-rate PCM loop at native base volume',async()=>{
+  const h=harness(),r=h.audio.play(idle);await settle();
+  assert.equal(r.element.nativeBuffered,true);assert.deepEqual(h.requests,['assets/audio/idlefee1.wav']);assert.equal(h.media.length,0);
+  assert.equal(h.sources.length,1);const source=h.sources[0];
+  assert.equal(source.loop,true);assert.equal(source.playbackRate.value,1);assert.equal(source.loopStart,0);
+  assert.ok(source.loopEnd<duration&&source.loopEnd>duration-1/44100);
+  for(let i=0;i<12;i++){
+    h.context.currentTime=i*duration+.5;h.audio.update(.1);
+    near(r.element.currentTime,.5);near(r.element.volume,nativeGainToAmplitude(.4));
+    assert.equal(r.wait,null);assert.equal(h.sources.length,1);
+  }
+  // The deliberate player-relative 3x hearing radius still survives a remote
+  // authored overview camera; adjusting base gain must not shrink its range.
+  h.audio.update(.1,[100000,100000,100000]);near(r.distanceGain,1);
+  near(r.element.volume,nativeGainToAmplitude(.4));h.audio.reset();assert.equal(source.stopped,true);
+});
+
+test('legacy media save resumes the idle sample and gain once across pause and repeated reload',async()=>{
+  const old=harness({available:false}),r=old.audio.play(idle);r.element.currentTime=.755573;
+  const saved=JSON.parse(JSON.stringify(old.audio.saveState()));assert.equal(saved.sounds[0].volume,1);
+  const h=harness();assert.equal(h.audio.restoreState(saved),true);await settle();
+  let voice=h.audio.keyed.get(idle.key);assert.equal(h.sources.length,1);near(h.sources[0].offset,.755573);
+  near(voice.element.volume,nativeGainToAmplitude(.4));
+  h.context.currentTime=.25;h.audio.pause();const at=voice.element.currentTime;
+  h.context.currentTime=10;near(voice.element.currentTime,at);h.audio.resume();await settle();near(h.sources.at(-1).offset,at);
+  for(let i=0;i<3;i++){
+    const state=JSON.parse(JSON.stringify(h.audio.saveState()));assert.equal(state.sounds[0].volume,1);
+    h.audio.restoreState(state);await settle();voice=h.audio.keyed.get(idle.key);
+    near(voice.element.volume,nativeGainToAmplitude(.4));assert.equal(h.audio.sounds.size,1);
+  }
+  h.audio.stop(idle.key);assert.equal(h.audio.sounds.size,0);assert.equal(h.sources.at(-1).stopped,true);
+});
+
+test('fairy deactivation before decode cannot start a late loop; other cues retain their gain and media path',async()=>{
+  const h=harness({pending:true});h.audio.play(idle);h.audio.stop(idle.key);h.finish();await settle();
+  assert.equal(h.sources.length,0);assert.equal(h.audio.sounds.size,0);
+  for(const sound of ['gri5fx11.wav','magiev12.wav','idlefee1.wav']){
+    const r=h.audio.play({sound});assert.equal(r.element.nativeBuffered,undefined);assert.equal(r.loop,false);near(r.element.volume,1);
+  }
+  h.audio.queueDialogue({voice:'flgen30.wav'});assert.equal(h.media.length,4);assert.equal(h.requests.length,1);h.audio.reset();
+});
+
+test('fairy loop retains a working media fallback without Web Audio',()=>{
+  const h=harness({available:false}),r=h.audio.play(idle);
+  assert.equal(h.requests.length,0);assert.equal(h.media.length,1);assert.equal(r.element.loop,true);assert.equal(r.element.paused,false);
+  near(r.element.volume,nativeGainToAmplitude(.4));h.audio.pause();assert.equal(r.element.paused,true);
+  h.audio.resume();assert.equal(r.element.paused,false);h.audio.reset();assert.equal(r.element.src,null);
+});
diff --git a/tests/fairy-ribbon-native.test.mjs b/tests/fairy-ribbon-native.test.mjs
new file mode 100644
index 00000000..3175d6da
--- /dev/null
+++ b/tests/fairy-ribbon-native.test.mjs
@@ -0,0 +1,123 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {
+  NativeFairyEffect,FAIRY_STEP,FAIRY_RIBBON_WIDTH,FAIRY_RIBBON_DISTANCE,
+  FAIRY_RIBBON_TEXTURE,fairyRibbonOpacity,
+} from '../src/fairy-effects.js';
+
+const options={origin:[0,0,0],waypoints:[[0,0,0]],lifeTime:0,seed:712};
+const close=(actual,expected)=>assert.ok(Math.abs(actual-expected)<1e-10,`${actual} != ${expected}`);
+const json=value=>JSON.parse(JSON.stringify(value));
+const tips=x=>Array.from({length:5},(_,i)=>[x,i*20,0]);
+
+test('fairy ribbon uses native alpha100/255, linear800ms attenuation and alpha5 cutoff',()=>{
+  close(fairyRibbonOpacity(0),100/255);
+  close(fairyRibbonOpacity(200),75/255);
+  close(fairyRibbonOpacity(400),50/255);
+  close(fairyRibbonOpacity(600),25/255);
+  assert.ok(fairyRibbonOpacity(759)>5/255);
+  // The native float calculation can round alpha at exactly760ms just above
+  // five. At the following integer millisecond it is unambiguously culled.
+  assert.ok(fairyRibbonOpacity(760)<=5/255+1e-12);
+  assert.equal(fairyRibbonOpacity(761),0);
+  assert.equal(fairyRibbonOpacity(800),0);
+  assert.equal(fairyRibbonOpacity(1000),0);
+  close(FAIRY_RIBBON_WIDTH,1.92);
+  close(FAIRY_RIBBON_DISTANCE,1.6);
+  assert.equal(FAIRY_RIBBON_TEXTURE,'ptrail.bmp|ptrail_a.bmp');
+});
+
+test('fairy ribbon commits a history point only beyond1.6units and keeps a moving head',()=>{
+  const effect=new NativeFairyEffect(options);effect.trails=[];
+  effect.time=0;effect.updateRibbon(tips(0));
+  const initial=effect.trails.length;
+  effect.time=.01;effect.updateRibbon(tips(1));
+  assert.equal(effect.trails.length,initial);
+  for(let i=0;i<5;i++) {
+    const head=effect.trails.filter(t=>t.orbiter===i).at(-1);
+    assert.deepEqual(head.start,[1,i*20,0]);
+    close(head.born,.01);
+  }
+  effect.time=.02;effect.updateRibbon(tips(1.6));
+  assert.equal(effect.trails.length,initial,'equality does not commit another point');
+  effect.time=.03;effect.updateRibbon(tips(1.601));
+  assert.equal(effect.trails.length,initial+5);
+  for(let i=0;i<5;i++) {
+    const head=effect.trails.filter(t=>t.orbiter===i).at(-1);
+    assert.deepEqual(head.start,head.end,'a committed point starts the next moving-head segment');
+  }
+});
+
+test('fairy ribbon first quad uses its newer timestamp and following quads use their older timestamp',()=>{
+  const effect=new NativeFairyEffect(options);effect.time=.6;
+  effect.trails=[
+    {end:[0,0,0],start:[2,0,0],fromBorn:0,born:.2,orbiter:0},
+    {end:[2,0,0],start:[4,0,0],fromBorn:.2,born:.4,orbiter:0},
+    {end:[4,0,0],start:[6,0,0],fromBorn:.4,born:.6,orbiter:0},
+    {end:[6,0,0],start:[6,0,0],fromBorn:.6,born:.6,orbiter:0},
+  ];
+  const rays=effect.geometry().rays.filter(ray=>Math.hypot(...ray.start.map((v,i)=>v-ray.end[i]))>0);
+  assert.equal(rays.length,3);
+  assert.deepEqual(rays.map(ray=>[ray.start,ray.end]),[
+    [[0,0,0],[2,0,0]],[[2,0,0],[4,0,0]],[[4,0,0],[6,0,0]],
+  ]);
+  [50,50,75].forEach((alpha,i)=>close(rays[i].opacity,alpha/255));
+  assert.ok(rays.every(ray=>ray.width===1.92));
+  effect.time=100;
+  assert.deepEqual(effect.geometry().rays,rays,'drawing uses the last trail update timestamp, not the render clock');
+});
+
+test('fairy ribbon disappears with central particle while departure stars keep their own fade',()=>{
+  const effect=new NativeFairyEffect(options);effect.advance(2);
+  assert.ok(effect.geometry().rays.length>0);
+  effect.requestStop();assert.deepEqual(effect.advance(FAIRY_STEP),['departure']);
+  assert.equal(effect.active,false);
+  assert.deepEqual(effect.geometry().rays,[]);
+  assert.ok(effect.geometry().sprites.length>0,'departure burst remains visible');
+  assert.equal(effect.geometry().light,null);
+  effect.advance(.4);assert.deepEqual(effect.geometry().rays,[]);
+  assert.ok(effect.geometry().sprites.length>0);
+});
+
+test('fairy ribbon snapshot preserves point timestamps and fractional clock without mutating on draw',()=>{
+  const effect=new NativeFairyEffect(options);effect.advance(2.107);
+  const saved=json(effect.snapshot()),restored=NativeFairyEffect.restore(saved);
+  assert.equal(saved.trailFormat,2);
+  assert.ok(saved.trails.every(t=>Number.isFinite(t.fromBorn)&&Number.isInteger(t.orbiter)));
+  assert.ok(restored);assert.deepEqual(restored.snapshot(),effect.snapshot());
+  assert.deepEqual(restored.geometry(),effect.geometry());
+  const before=restored.snapshot();restored.geometry();restored.geometry();restored.advance(0);
+  assert.deepEqual(restored.snapshot(),before);
+  for(const dt of [.007,.05,.2,.7]) {
+    effect.advance(dt);restored.advance(dt);
+    assert.deepEqual(restored.geometry(),effect.geometry());
+    assert.deepEqual(restored.snapshot(),effect.snapshot());
+  }
+});
+
+test('legacy segment-only fairy saves migrate without rejecting the rest of their effect state',()=>{
+  const effect=new NativeFairyEffect(options);effect.advance(.1);
+  const saved=json(effect.snapshot());delete saved.trailFormat;
+  saved.trails=Array.from({length:10},(_,i)=>({start:[i,0,0],end:[i-1,0,0],born:i<5?.05:.1}));
+  const restored=NativeFairyEffect.restore(saved);assert.ok(restored);
+  assert.equal(restored.trailFormat,2);
+  assert.deepEqual(restored.pool,effect.pool);
+  assert.equal(restored.randomState,effect.randomState);
+  for(let orbiter=0;orbiter<5;orbiter++) {
+    const group=restored.trails.filter(t=>t.orbiter===orbiter);
+    assert.deepEqual(group.map(t=>t.start),[[orbiter,0,0],[orbiter+5,0,0],[orbiter+5,0,0]]);
+    assert.deepEqual(group.at(-1).start,group.at(-1).end);
+    assert.ok(group.every((t,i)=>i===0||t.fromBorn===group[i-1].born));
+  }
+  assert.ok(restored.trails.every(t=>t.fromBorn>=0&&t.fromBorn<=t.born));
+  restored.advance(.1);assert.ok(restored.geometry().rays.length>0);
+});
+
+test('malformed ribbon timing and ownership in new saves are rejected',()=>{
+  const effect=new NativeFairyEffect(options);effect.advance(.2);
+  const saved=json(effect.snapshot());
+  for(const alter of [s=>s.trails[0].orbiter=5,s=>s.trails[0].orbiter=.5,
+    s=>s.trails[0].fromBorn=-1,s=>s.trails[0].fromBorn=s.time+1,s=>s.trails[0].fromBorn=NaN]) {
+    const invalid=json(saved);alter(invalid);assert.equal(NativeFairyEffect.restore(invalid),null);
+  }
+});
diff --git a/tests/gameplay-update-work.test.mjs b/tests/gameplay-update-work.test.mjs
new file mode 100644
index 00000000..59d15741
--- /dev/null
+++ b/tests/gameplay-update-work.test.mjs
@@ -0,0 +1,95 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {Gameplay} from '../src/gameplay.js';
+import {ScriptHost} from '../src/script-host.js';
+
+const entity=(classname,name,extra={})=>({classname,'%name%':name,DaviName:name,Origin:'0 0 0',...extra});
+const level=entities=>({id:'update-work',entities});
+
+test('pickup checks keep authored trigger order without querying unrelated object positions',()=>{
+  const events=[],game=new Gameplay(level([
+    entity('ItemPotion','before',{IsInitiallyEnabled:'0'}),
+    ...Array.from({length:100},(_,i)=>entity('GrobberPathPoint',`point${i}`)),
+    entity('Trigger','enable',{CommandOnEnter:'before.enable; after.enable',MaxTriggerTimes:'1'}),
+    entity('ItemPotion','after',{IsInitiallyEnabled:'0'})
+  ]),{onEvent:event=>events.push(event)});
+  const positions=[],objectPosition=game.objectPosition.bind(game);
+  game.objectPosition=object=>{positions.push(object.id);return objectPosition(object);};
+  game.update(.02,[0,0,0]);
+  assert.equal(game.find('before')[0].collected,false,'earlier objects wait for the next frame');
+  assert.equal(game.find('after')[0].collected,true,'a later enabled pickup is collected this frame');
+  game.update(.02,[0,0,0]);
+  assert.deepEqual(events.filter(event=>event.type==='pickup').map(event=>event.id),['after','before']);
+  assert.equal(game.state.potions,2);
+  assert.deepEqual(positions.filter(id=>id!=='before'&&id!=='after'),[],
+    'logic and trigger positions must not be queried for an unused pickup distance');
+});
+
+test('pickup checks retain settled anchors, current support transforms and line of sight',()=>{
+  const game=new Gameplay(level([
+    entity('%Model%','support',{Model:'1'}),
+    entity('ItemPotion','mounted',{Origin:'1000 0 0',Model:'support'})
+  ])),host=new ScriptHost(game,{version:27}),pickup=game.find('mounted')[0];
+  pickup.pickupPlacement={offsetY:18};
+  host.modelTransforms.set(1,{origin:[0,0,0],translation:[-1000,0,0],rotation:[0,0,0,1]});
+  const rays=[];
+  game.update(.02,[0,0,0],{lineOfSight:(from,to)=>{rays.push([from,to]);return false;}});
+  assert.equal(pickup.collected,false);
+  game.update(.02,[0,0,0],{lineOfSight:(from,to)=>{rays.push([from,to]);return true;}});
+  assert.equal(pickup.collected,true);
+  assert.deepEqual(rays,Array.from({length:2},()=>[[0,22,0],[0,36,0]]));
+  assert.deepEqual(game.rewardEffects[0].position,[0,18,0]);
+  assert.deepEqual(pickup.position,[1000,0,0],'the authored anchor must not accumulate its support transform');
+});
+
+function movingHost() {
+  const game=new Gameplay(level([
+    entity('%Model%','brush',{Model:'1'}),
+    entity('ModelController','mover',{Model:'brush'})
+  ]));
+  const clip={model:1,origin:[12,0,4],startTime:0,endTime:1,paths:[{
+    translation:{times:[0,1],values:[0,0,0,10,0,0],interpolation:0}
+  }],events:[{time:0,label:'start'},{time:.5,label:'middle'},{time:1,label:'end'}]};
+  const host=new ScriptHost(game,{version:27},{motions:{motions:[clip]}}),object=game.find('mover')[0],player=host.players.get(object.id);
+  const events=[],samples=[],sample=player.sample.bind(player);
+  player.sample=(...args)=>{const pose=sample(...args);samples.push(pose);return pose;};
+  game.runEvent=(_object,event,args)=>{if(event==='MotionCommand')events.push(args[0]);};
+  host.startMotion(object);
+  return {game,host,object,player,events,samples};
+}
+
+function assertSingleFinalPose(scene,dt) {
+  const before=scene.samples.length;
+  scene.host.update(dt);
+  assert.equal(scene.samples.length-before,1,'host must consume the final pose returned by the motion update');
+  const actual=scene.host.modelTransforms.get(1),sample=scene.samples.at(-1);
+  assert.deepEqual(actual,{...sample,origin:scene.player.motion.origin});
+  assert.equal(actual.translation,sample.translation);
+}
+
+test('brush host reuses the accepted final pose while blocked segments wait and resume',()=>{
+  const scene=movingHost();let allowed=.4;
+  scene.host.beforeMotionAdvance=(_object,_player,_from,to)=>to<=allowed;
+  assertSingleFinalPose(scene,1);
+  assert.equal(scene.player.time,0);assert.deepEqual(scene.events,['start']);
+  allowed=.75;assertSingleFinalPose(scene,1);
+  assert.equal(scene.player.time,.5);assert.deepEqual(scene.events,['start','middle']);
+  allowed=1;assertSingleFinalPose(scene,1);
+  assert.equal(scene.player.time,1);assert.deepEqual(scene.events,['start','middle','end']);
+  assert.equal(scene.player.finished,true);assert.equal(scene.object.enabled,false);
+});
+
+test('brush host uses the final pose after a callback replaces playback',()=>{
+  const scene=movingHost();
+  scene.game.runEvent=(_object,event,args)=>{
+    if(event!=='MotionCommand')return;
+    scene.events.push(args[0]);
+    if(args[0]==='middle')scene.player.play({from:.75,to:1});
+  };
+  assertSingleFinalPose(scene,1);
+  assert.equal(scene.player.time,.75);assert.equal(scene.player.playing,true);
+  assert.deepEqual(scene.events,['start','middle']);
+  assert.deepEqual(scene.host.modelTransforms.get(1).translation,[7.5,0,0]);
+  assertSingleFinalPose(scene,.25);
+  assert.deepEqual(scene.events,['start','middle','end']);assert.equal(scene.player.finished,true);
+});
diff --git a/tests/hud-redraw.test.mjs b/tests/hud-redraw.test.mjs
new file mode 100644
index 00000000..c56bace8
--- /dev/null
+++ b/tests/hud-redraw.test.mjs
@@ -0,0 +1,141 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {readFileSync} from 'node:fs';
+import {runInNewContext} from 'node:vm';
+import {OriginalHud} from '../src/hud.js';
+
+const manifest=JSON.parse(readFileSync(new URL('../assets/hud/manifest.json',import.meta.url)));
+class LoadedHud extends OriginalHud {
+  async load(){this.manifest=structuredClone(manifest);this.atlas={complete:true,src:'hud.png'};}
+}
+function fixture(t) {
+  const previous=globalThis.window,browser={devicePixelRatio:1};globalThis.window=browser;
+  t.after(()=>{if(previous===undefined)delete globalThis.window;else globalThis.window=previous;});
+  const calls={draw:[],clear:[],transform:[],rect:0},listeners=new Map(),rect={width:640,height:480};
+  const context={
+    setTransform(...args){calls.transform.push(args);},
+    clearRect(...args){calls.clear.push(args);},
+    drawImage(...args){if(this.failNext){this.failNext=false;throw new Error('draw failed');}calls.draw.push(args);}
+  };
+  const canvas={width:640,height:480,getContext:()=>context,
+    getBoundingClientRect(){calls.rect++;return {...rect};},
+    addEventListener(name,callback){listeners.set(name,callback);}
+  };
+  const hud=new LoadedHud(canvas),input={state:{health:8,maxHealth:10,lives:3,potions:4,score:9000},totalPotions:15,
+    enemy:{kind:'enemy',enemyType:'bat',variant:1,health:6,maxHealth:8},viewWidth:640,viewHeight:480,bottomInset:0};
+  const render=()=>hud.render(input.state,input.totalPotions,input.enemy,input.viewWidth,input.viewHeight,{bottomInset:input.bottomInset});
+  return {hud,input,canvas,context,calls,rect,browser,listeners,render};
+}
+
+test('unchanged HUD frames retain pixels without clear/draw calls while still measuring layout',t=>{
+  const f=fixture(t);f.render();
+  const draws=f.calls.draw.length;assert.ok(draws>10);
+  for(let i=0;i<60;i++)f.render();
+  assert.equal(f.calls.clear.length,1);assert.equal(f.calls.draw.length,draws);
+  assert.equal(f.calls.transform.length,2);assert.equal(f.calls.rect,61);
+  f.input.state={...f.input.state};f.input.enemy={...f.input.enemy,position:[20,30,40]};f.render();
+  assert.equal(f.calls.draw.length,draws,'new object identities and non-HUD position changes do not redraw');
+});
+
+test('every displayed state and target value invalidates the HUD drawing',t=>{
+  const f=fixture(t),changes=[
+    ['health',()=>f.input.state.health--],
+    ['max health',()=>f.input.state.maxHealth+=2],
+    ['lives',()=>f.input.state.lives++],
+    ['potions and digit spacing',()=>f.input.state.potions=123],
+    ['score',()=>f.input.state.score++],
+    ['level potion total',()=>f.input.totalPotions++],
+    ['enemy health',()=>f.input.enemy.health--],
+    ['enemy max health',()=>f.input.enemy.maxHealth+=2],
+    ['enemy variant',()=>f.input.enemy.variant=2],
+    ['enemy subtype fallback',()=>{delete f.input.enemy.variant;f.input.enemy.entity={SubType:'3'};}],
+    ['enemy type',()=>f.input.enemy.enemyType='witch'],
+    ['non-enemy target',()=>f.input.enemy.kind='actor'],
+    ['eligible enemy returns',()=>f.input.enemy.kind='enemy'],
+    ['dead target disappears',()=>f.input.enemy.health=0],
+    ['positive target health returns',()=>f.input.enemy.health=3],
+    ['target cleared',()=>f.input.enemy=null],
+    ['legacy target without kind',()=>f.input.enemy={enemyType:'knight',health:1}]
+  ];
+  f.render();
+  for(const [name,change] of changes){
+    const before=f.calls.clear.length;change();f.render();
+    assert.equal(f.calls.clear.length,before+1,name);
+    f.render();assert.equal(f.calls.clear.length,before+1,`${name}: unchanged next frame`);
+  }
+});
+
+test('HUD redraw follows CSS size, game viewport, DPR and touch inset changes',t=>{
+  const f=fixture(t),changes=[
+    ['CSS width',()=>f.rect.width=900],['CSS height',()=>f.rect.height=600],
+    ['game width',()=>f.input.viewWidth=1024],['game height',()=>f.input.viewHeight=768],
+    ['DPR',()=>f.browser.devicePixelRatio=2],['touch inset',()=>f.input.bottomInset=200],
+    ['portrait rotation',()=>{f.rect.width=390;f.rect.height=844;f.input.viewWidth=390;f.input.viewHeight=844;}]
+  ];
+  f.render();
+  for(const [name,change] of changes){
+    const before=f.calls.clear.length;change();f.render();
+    assert.equal(f.calls.clear.length,before+1,name);
+    assert.equal(f.canvas.width,Math.round(f.rect.width*f.browser.devicePixelRatio));
+    assert.equal(f.canvas.height,Math.round(f.rect.height*f.browser.devicePixelRatio));
+    f.render();assert.equal(f.calls.clear.length,before+1,`${name}: unchanged next frame`);
+  }
+});
+
+test('HUD redraw follows artwork replacement and recovers after artwork is temporarily unavailable',t=>{
+  const f=fixture(t);f.render();
+  for(const change of [
+    ()=>f.hud.atlas={...f.hud.atlas},
+    ()=>f.hud.atlas.src='replacement.png',
+    ()=>f.hud.manifest=structuredClone(f.hud.manifest),
+    ()=>f.hud.manifest.width+=1,
+    ()=>f.hud.manifest.height+=1
+  ]){
+    const before=f.calls.clear.length;change();f.render();assert.equal(f.calls.clear.length,before+1);
+  }
+  const before=f.calls.clear.length,loaded=f.hud.manifest;
+  f.hud.atlas.complete=false;f.render();assert.equal(f.calls.clear.length,before);
+  f.hud.atlas.complete=true;f.render();assert.equal(f.calls.clear.length,before+1);
+  f.hud.manifest=null;f.render();assert.equal(f.calls.clear.length,before+1);
+  f.hud.manifest=loaded;f.render();assert.equal(f.calls.clear.length,before+2);
+});
+
+test('canvas resets and restored contexts redraw an otherwise unchanged HUD',t=>{
+  const f=fixture(t);f.render();
+  f.canvas.width=1;f.render();assert.equal(f.calls.clear.length,2);assert.equal(f.canvas.width,640);
+  f.canvas.height=1;f.render();assert.equal(f.calls.clear.length,3);assert.equal(f.canvas.height,480);
+  f.listeners.get('contextlost')();f.render();assert.equal(f.calls.clear.length,4);
+  f.listeners.get('contextrestored')();f.render();assert.equal(f.calls.clear.length,5);
+  f.render();assert.equal(f.calls.clear.length,5);
+  // Any explicit owner clearing path can invalidate even with identical size.
+  f.context.clearRect(0,0,640,480);f.hud.invalidate();f.render();assert.equal(f.calls.clear.length,7);
+});
+
+test('a failed draw cannot retain the signature of an earlier cleared image',t=>{
+  const f=fixture(t);f.render();
+  f.input.state.score++;f.context.failNext=true;
+  assert.throws(()=>f.render(),/draw failed/);
+  f.input.state.score--;f.render();
+  assert.equal(f.calls.clear.length,3,'restoring the earlier values must redraw its cleared pixels');
+  f.render();assert.equal(f.calls.clear.length,3);
+});
+
+test('main HUD counter updates write only changed text and keep checking canvas layout',()=>{
+  const source=readFileSync(new URL('../src/main.js',import.meta.url),'utf8');
+  const start=source.indexOf('function renderHud(){'),end=source.indexOf('\nfunction updateSkipIndicator',start);
+  assert.ok(start>=0&&end>start);
+  const writes=[],nodes=new Map();
+  for(const key of ['health','lives','score','potions','mirror']){
+    let text='';nodes.set(key,{get textContent(){return text;},set textContent(value){text=String(value);writes.push([key,text]);}});
+  }
+  nodes.set('game',{width:640,height:480});
+  const state={health:10,lives:3,score:0,potions:0,mirror:0},draws=[];
+  const render=runInNewContext(`${source.slice(start,end)};renderHud;`,{
+    gameplay:{state,totalPotions:15},world:{targeting:{locked:false}},$:id=>nodes.get(id),
+    originalHud:{render(...args){draws.push(args);}},touchEnabled:false,controllerActive:false
+  });
+  render();assert.equal(writes.length,5);
+  render();assert.equal(writes.length,5);assert.equal(draws.length,2);
+  state.health=9.5;render();assert.deepEqual(writes.at(-1),['health','9.5']);assert.equal(writes.length,6);
+  state.mirror=1;render();assert.deepEqual(writes.at(-1),['mirror','1']);assert.equal(writes.length,7);
+});
