+  const colored=['spider','bat','ghost'].includes(base);
+  return {base,variant,actorFile:colored?base+['g','y','r'][variant-1]:base,
+    stats:settings[config+(colored?variant:'')]?.[difficulty]||settings[config]?.[difficulty]||{}};
+}
