+  return {ItemCoin:'imoney'+suffix,ItemHealth:'ihealth'+suffix,ItemPotion:'ipotion',ItemMirror:'imirror',ItemLife:'ilife',ItemHart:'hartcontainer',ItemHartContainer:'hartcontainer'}[e.classname];
