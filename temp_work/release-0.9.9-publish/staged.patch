+    // RedCat jumping must not aim a grounded enemy's horizontal sweep upward.
+    const clear=(a,b)=>{const hit=trace(a,[b[0],a[1],b[2]],mins,maxs);return !hit.startSolid&&hit.fraction>.999;};
