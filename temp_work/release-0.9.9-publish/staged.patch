+  await page.waitForFunction(id => __redcat.profiles.activeId === id && !__redcat.playerMenu.openDialog, other.id, {polling: 100});
+  report.deadSwitch = await page.evaluate(() => ({active: __redcat.profiles.activeId,
+    worldRetired: __redcat.world === null, latestUnchanged: localStorage.getItem('redcat.save.v1') === __livingBytes,
+    newSave: localStorage.getItem(__redcat.profiles.key('redcat.save.v1')),
+    recoveryEntries: __redcat.recovery.state.checkpoints.length}));
+  assert.equal(report.deadSwitch.latestUnchanged, true);
+  assert.equal(report.deadSwitch.worldRetired, true);
+  assert.equal(report.deadSwitch.newSave, null); assert.equal(report.deadSwitch.recoveryEntries, 0);
+
+  // A living save failure still blocks profile switching rather than silently
+  // discarding that player's unsaved progress.
+  await page.evaluate(async () => {await __redcat.startLevel(0); __redcat.pause();});
+  await page.locator('#return-menu').click();
+  await page.evaluate(() => {
+    const key = __redcat.profiles.key('redcat.save.v1');
+    Storage.prototype.setItem = function (name, value) {
+      if (name === key) throw new DOMException('Fixture quota failure', 'QuotaExceededError');
+      return __originalSetItem.call(this, name, value);
+    };
+  });
+  await page.locator('#open-players').click(); await page.locator('[data-player-id="legacy"]').click();
+  await page.locator('#player-select').click();
+  await page.waitForFunction(() => !__redcat.playerMenu.busy, null, {polling: 100});
+  report.livingFailure = await page.evaluate(() => ({active: __redcat.profiles.activeId,
+    worldPresent: !!__redcat.world, dialog: !!__redcat.playerMenu.openDialog,
+    message: document.getElementById('player-list-status').textContent}));
+  assert.equal(report.livingFailure.active, other.id); assert.equal(report.livingFailure.worldPresent, true);
+  assert.equal(report.livingFailure.dialog, true); assert.match(report.livingFailure.message, /Wisselen is afgebroken/);
+  await page.evaluate(() => {Storage.prototype.setItem = __originalSetItem;});
+  await page.locator('#player-select').click();
+  await page.waitForFunction(() => __redcat.profiles.activeId === 'legacy' && !__redcat.playerMenu.openDialog, null, {polling: 100});
+  assert.equal(await page.evaluate(() => localStorage.getItem('redcat.save.v1') === __livingBytes), true);
+
+  // Explicit old-format death-animation fixture: newly writing a dead save is
+  // blocked, but older saves with a remaining life must still load and respawn.
+  report.legacyLoad = await page.evaluate(async () => {
+    const save = JSON.parse(__livingBytes);
+    save.game.state.health = 0; save.game.state.lives = 2;
+    save.game.playerReaction = {phase: 'death', age: .4};
+    delete save.playerAnimation;
+    localStorage.setItem('redcat.save.v1', JSON.stringify(save));
+    const loaded = await __redcat.loadSave();
+    return {loaded, health: __redcat.gameplay.state.health, lives: __redcat.gameplay.state.lives,
+      phase: __redcat.gameplay.playerReaction?.phase, age: __redcat.gameplay.playerReaction?.age};
+  });
+  assert.deepEqual(report.legacyLoad, {loaded: true, health: 0, lives: 2, phase: 'death', age: .4});
+  await page.evaluate(async () => {for (let i = 0; i < 35; i++) {__testFrame(.05); await new Promise(r => setTimeout(r, 0));}});
+  report.respawn = await page.evaluate(() => ({health: __redcat.gameplay.state.health,
+    lives: __redcat.gameplay.state.lives, phase: __redcat.gameplay.playerReaction?.phase,
+    position: [...__redcat.world.player.position], checkpoint: [...__redcat.gameplay.checkpoint.position]}));
+  assert.equal(report.respawn.health, 10); assert.equal(report.respawn.lives, 2); assert.equal(report.respawn.phase, 'respawn');
+  assert.deepEqual(report.respawn.position, report.respawn.checkpoint.map((v, i) => v + (i === 1 ? 1 : 0)));
+  await page.keyboard.press('F5'); await page.evaluate(() => __redcat.recovery.flush());
+  report.respawnSave = await page.evaluate(() => ({health: JSON.parse(localStorage.getItem('redcat.save.v1')).game.state.health,
+    lives: JSON.parse(localStorage.getItem('redcat.save.v1')).game.state.lives,
+    message: document.getElementById('toast').textContent}));
+  assert.equal(report.respawnSave.health, 10); assert.equal(report.respawnSave.lives, 2);
+  assert.equal(report.respawnSave.message, 'Je avontuur is opgeslagen.');
+  await page.screenshot({path: `${out}/living-respawn-saved.png`});
+  assert.deepEqual(errors, []);
+  report.passed = true;
+  console.log(`PASS death-save protection, all save entry points, dead profile switch, living write failure, legacy death load and new respawn save. ${out}`);
+} catch (error) {
+  report.failure = error.stack;
+  throw error;
+} finally {
+  await writeFile(`${out}/report.json`, JSON.stringify({...report, errors}, null, 2));
+  await context?.close(); server.kill();
+}
diff --git a/tests/destructible-threshold.test.mjs b/tests/destructible-threshold.test.mjs
new file mode 100644
index 00000000..6b846d34
--- /dev/null
+++ b/tests/destructible-threshold.test.mjs
@@ -0,0 +1,113 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {Group,Mesh,BoxGeometry,MeshBasicMaterial} from 'three';
+import {Gameplay} from '../src/gameplay.js';
+import {CastleWorld,actorVisible} from '../src/world.js';
+import {targetableObject} from '../src/targeting.js';
+import {damageDestructible,restorePropDamage} from '../src/destructible-damage.js';
+import {advanceExplosionDamage} from '../src/explosion-damage.js';
+
+const entity=(classname,name,extra={})=>({classname,'%name%':name,DaviName:name,Origin:'0 0 0',...extra});
+const level={id:'prop-threshold',entities:[
+  entity('AdamAnyActor','crate',{ActorFileName:'brcrate.act',Targetable:'1',AfterDestroyCommand:'door.open'}),
+  entity('DoorModel','door'),entity('MovingEnemy','frog',{Type:'5',Origin:'1000 0 0'})
+]};
+function configure(game,limit=1) {
+  const crate=game.find('crate')[0],actor=new Group();
+  actor.userData.template={data:{settings:{destroyable:true,canBeShot:true,damageThreshold:[limit,limit]}}};
+  CastleWorld.prototype.configureDestructible.call({},crate,actor);
+  return crate;
+}
+function fixture(limit=1,save=null) {
+  const events=[],game=new Gameplay(level,{save,onEvent:event=>events.push(event)});
+  return {game,crate:configure(game,limit),events};
+}
+const hit=(game,crate,damage)=>game.playerProjectileHit(crate,{damage,type:1});
+
+test('a prop survives exact projectile equality, remains targetable/collidable, and breaks on the next positive hit',()=>{
+  const {game,crate,events}=fixture();
+  const actor=new Group(),mesh=new Mesh(new BoxGeometry(10,10,10),new MeshBasicMaterial());
+  actor.add(mesh);actor.userData.mesh=mesh;
+  const world={gameplay:game};CastleWorld.prototype.configureExplosionTarget.call(world,crate,actor);
+  const collision=CastleWorld.prototype.actorCollisionRecord.call(world,crate,actor,{blocksPlayer:true,canBeShot:true});
+  hit(game,crate,1);
+  assert.equal(crate.propDamage,1);assert.equal(crate.health,1);assert.equal(crate.enabled,true);
+  assert.equal(actorVisible(crate,game.time),true);assert.equal(targetableObject(crate),true);
+  assert.equal(crate.explosionActive(),true);assert.equal(collision.active(),true);assert.equal(game.find('door')[0].open,false);
+  assert.equal(game.explosions.length,0);
+  hit(game,crate,.125);
+  assert.equal(crate.health,0);assert.equal(crate.enabled,false);assert.equal(actorVisible(crate,game.time),false);
+  assert.equal(collision.active(),false);
+  assert.equal(targetableObject(crate),false);assert.equal(game.find('door')[0].open,true);
+  hit(game,crate,1);game.destroy(crate);
+  assert.equal(game.explosions.length,1);assert.equal(events.filter(e=>e.type==='enemyDefeated'&&e.id==='crate').length,1);
+  mesh.geometry.dispose();mesh.material.dispose();
+});
+
+test('all projectile strengths and partial hits use the same strict accumulated limit',()=>{
+  for(const limit of [1,2,4,100]) {
+    const {game,crate}=fixture(limit);
+    hit(game,crate,limit*.25);hit(game,crate,limit*.75);
+    assert.equal(crate.propDamage,limit);assert.equal(crate.health,limit);
+    hit(game,crate,.25);assert.equal(crate.health,0);
+  }
+});
+
+test('blast and projectile damage share one accumulator without suppressing later blast ticks at equality',()=>{
+  const {game,crate}=fixture(2);
+  hit(game,crate,1);
+  crate.explosionBounds=()=>({origin:[0,0,0],min:[0,0,0],max:[0,0,0]});
+  game.explosionDamage=[{sourceId:'other',birth:0,position:[0,0,0],radius:100,rate:10}];
+  game.time=.1;advanceExplosionDamage(game,.1,[1000,0,0]);
+  assert.equal(crate.propDamage,2);assert.equal(crate.health,2);assert.equal(game.explosions.length,0);
+  game.time=.2;advanceExplosionDamage(game,.1,[1000,0,0]);
+  assert.equal(crate.health,0);assert.equal(game.explosions.length,1);
+});
+
+test('saving at exact equality preserves an intact prop and its next-hit destruction across actor loading',()=>{
+  const {game,crate}=fixture(100);hit(game,crate,100);
+  const save=JSON.parse(JSON.stringify(game.snapshot()));
+  assert.equal(save.objects.find(o=>o.id==='crate').propDamage,100);
+  const restored=fixture(100,save);
+  assert.equal(restored.crate.health,100);assert.equal(restored.crate.propDamage,100);
+  assert.equal(actorVisible(restored.crate,0),true);
+  hit(restored.game,restored.crate,.125);assert.equal(restored.crate.health,0);
+  const destroyed=fixture(100,JSON.parse(JSON.stringify(restored.game.snapshot())));
+  assert.equal(destroyed.crate.health,0);assert.equal(destroyed.crate.propDamage,undefined);
+  assert.equal(actorVisible(destroyed.crate,0),false);assert.equal(destroyed.game.explosions.length,0);
+});
+
+test('legacy saves keep their remaining budget and same-world restoration clears newer accumulated damage',()=>{
+  const {game,crate}=fixture(100),legacy=JSON.parse(JSON.stringify(game.snapshot()));
+  const entry=legacy.objects.find(o=>o.id==='crate');entry.health=25;delete entry.propDamage;
+  hit(game,crate,99);assert.equal(crate.propDamage,99);
+  assert.equal(game.restore(legacy),true);configure(game,100);
+  assert.equal(crate.health,25);assert.equal(crate.propDamage,undefined);
+  hit(game,crate,25);assert.equal(crate.health,25);hit(game,crate,1);assert.equal(crate.health,0);
+  const fresh=fixture(100,legacy);hit(fresh.game,fresh.crate,25);
+  assert.equal(fresh.crate.health,25);assert.equal(fresh.crate.propDamage,25);
+});
+
+test('explicit script destruction still bypasses the threshold, including an equality-state prop',()=>{
+  const {game,crate}=fixture();hit(game,crate,1);
+  game.execute('crate.destroy');assert.equal(crate.health,0);assert.equal(game.find('door')[0].open,true);
+  game.execute('crate.destroy');assert.equal(game.explosions.length,1);
+});
+
+test('indestructible actors still run OnHit commands while ignoring damage, and enemy equality still defeats',()=>{
+  const {game,crate}=fixture();crate.actorSettings.destroyable=false;crate.entity.OnHitCommand='door.open';
+  hit(game,crate,100);assert.equal(crate.health,1);assert.equal(crate.propDamage,undefined);
+  assert.equal(game.find('door')[0].open,true);
+  const frog=game.find('frog')[0];game.hurtEnemy(frog,frog.health);assert.equal(frog.health,0);
+  assert.equal(frog.propDamage,undefined);assert.equal(game.state.kills,1);
+});
+
+test('invalid damage and accumulator state cannot revive destroyed props or poison future damage',()=>{
+  const {game,crate}=fixture();
+  for(const damage of [0,-1,NaN,Infinity])assert.equal(damageDestructible(game,crate,damage),false);
+  assert.equal(crate.propDamage,undefined);
+  for(const value of [-1,NaN,Infinity,2,undefined]){crate.propDamage=.5;restorePropDamage(crate,value);assert.equal(crate.propDamage,undefined);}
+  restorePropDamage(crate,1);assert.equal(crate.propDamage,1);
+  game.destroy(crate);restorePropDamage(crate,0);assert.equal(crate.propDamage,undefined);
+  assert.equal(damageDestructible(game,crate,1),false);assert.equal(game.explosions.length,1);
+});
diff --git a/tests/effects-save-continuity.test.mjs b/tests/effects-save-continuity.test.mjs
new file mode 100644
index 00000000..e0355797
--- /dev/null
+++ b/tests/effects-save-continuity.test.mjs
@@ -0,0 +1,116 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {readFileSync} from 'node:fs';
+import * as THREE from 'three';
+import {NativeSpoutEffect,restoreSpoutSnapshots} from '../src/spout-effects.js';
+import {KNIGHT_PARTS,restoreKnightDebrisState,snapshotKnightDebrisState} from '../src/knight-debris.js';
+import {stepNativeDebris} from '../src/debris-native.js';
+import {CastleWorld} from '../src/world.js';
+import {WorldEffects} from '../src/world-effects.js';
+
+const json=path=>JSON.parse(readFileSync(new URL('../'+path,import.meta.url)));
+const roundtrip=value=>JSON.parse(JSON.stringify(value));
+const entity={classname:'EffectSpoutEntity',DelaySecondsMin:.02,DelaySecondsMax:.08,LifeSecondsMin:.5,LifeSecondsMax:2,
+  SpeedMin:4,SpeedMax:12,AngleMin:0,AngleMax:30,Gravity:2,StartRadius:5,Scale:1,AlphaPercentageStart:100,AlphaPercentageEnd:25,
+  ColourFrom:'20 40 60',ColourTo:'100 90 80',ColourCycling:1,BitmapFileName:'smoke.bmp',BitmapAlphaFileName:'smoke_a.bmp'};
+
+test('smoke/flame saves retain every live slot, fractional tick, timers, colour and future births',()=>{
+  const original=new NativeSpoutEffect(entity,{seed:713});
+  for(let i=0;i<95;i++)original.update(1/120,[i,20,30],[0,1,0],true,3);
+  assert.ok(original.particles.length>0);assert.ok(original.remainder>0);
+  const saved=roundtrip(original.snapshot()),restored=NativeSpoutEffect.restore(entity,saved);
+  assert.ok(restored);assert.deepEqual(restored.snapshot(),saved);
+  restored.update(0,[200,0,0],[1,0,0],false);assert.deepEqual(restored.snapshot(),saved,'paused rendering does not reset saved timers');
+  for(let i=0;i<350;i++){
+    const dt=[.011,.027,.008][i%3],enabled=i<120||i>200,serial=i>250?4:3;
+    for(const effect of [original,restored])effect.update(dt,[i,10,30],[1,2,0],enabled,serial);
+    assert.deepEqual(restored.snapshot(),original.snapshot(),`continued simulation frame ${i}`);
+  }
+  restored.pool[0].position[0]++;assert.notDeepEqual(restored.snapshot(),original.snapshot(),'save values do not alias live state');
+});
+
+test('every shipped spout supports bounded save state including expired flash tails',()=>{
+  let count=0,totalBytes=0;
+  for(let level=0;level<5;level++)for(const e of json(`data/levels/lvl0${level}a/level.json`).entities.filter(e=>e.classname==='EffectSpoutEntity')){
+    const effect=new NativeSpoutEffect(e,{seed:count++});
+    for(let i=0;i<180;i++)effect.update(1/60,[0,0,0],[0,1,0]);
+    const saved=roundtrip(effect.snapshot()),restored=NativeSpoutEffect.restore(e,saved);
+    assert.ok(restored,e['%name%']);assert.deepEqual(restored.snapshot(),saved);
+    totalBytes+=JSON.stringify(saved).length;
+  }
+  assert.equal(count,139);assert.ok(totalBytes<1_500_000,`all five levels combined: ${totalBytes} bytes`);
+});
+
+test('invalid save pools, nonfinite numbers and duplicate emitter ids are rejected',()=>{
+  const effect=new NativeSpoutEffect(entity);effect.update(.1,[0,0,0],[0,1,0]);
+  const saved=effect.snapshot();
+  for(const mutate of [s=>s.pool.push(s.pool[0]),s=>s.pool[0][11]=Infinity,s=>s.remainder=1,s=>s.pool[0][0]='true']){
+    const copy=structuredClone(saved);mutate(copy);assert.equal(NativeSpoutEffect.restore(entity,copy),null);
+  }
+  const entry={id:'smoke',age:1,enableSerial:0,state:saved};
+  assert.equal(restoreSpoutSnapshots({version:1,entries:[entry,entry]}),undefined);
+  assert.equal(restoreSpoutSnapshots({version:1,entries:Array(4097).fill(entry)}),undefined);
+});
+
+test('world renderer hooks preserve saved smoke immediately without warm-up or catch-up',()=>{
+  const make=spoutStates=>{
+    const object={id:'smoke',entity,enabled:true,visible:true,position:[10,20,30]};
+    const game={objects:[object],spoutStates,find:()=>[],state:{},time:0};
+    const world={scene:new THREE.Scene(),camera:new THREE.PerspectiveCamera(),actorInstances:new Map(),modelMeshes:new Map(),physicalModels:[],collider:{trace:(_a,b)=>({fraction:1,end:b})}};
+    const effects=new WorldEffects(world,game,{textures:{}});effects.attachLights();
+    const draws=[],batch={count:0,add(...values){draws.push(roundtrip(values));},flush(){},mesh:new THREE.Object3D()};
+    effects.batches.set('smoke.bmp|smoke_a.bmp',batch);return {game,effects,draws};
+  };
+  const before=make();for(let i=0;i<80;i++)before.effects.update(1/60);
+  before.draws.length=0;before.effects.update(0);
+  const saved=roundtrip(before.game.spoutSnapshot()),after=make(saved);after.effects.update(0);
+  assert.deepEqual(after.game.spoutSnapshot(),saved);assert.deepEqual(after.draws,before.draws);
+  after.game.objects[0].enabled=false;after.effects.update(0);
+  assert.deepEqual(after.game.spoutSnapshot(),saved,'temporary load-camera visibility cannot reset saved age on a zero-time draw');
+  assert.equal(after.game.spoutStates,undefined);
+  after.effects.dispose();assert.equal(after.game.spoutSnapshot,undefined);before.effects.dispose();
+});
+
+function knightFixture(){
+  const templates=KNIGHT_PARTS.map(name=>({data:json(`assets/actors/${name}.json`)}));
+  const actor={userData:{mesh:{scale:{x:1}},template:{data:json('assets/actors/knight.json')}}};
+  const object={id:'knight-test',position:[10,100,20],health:0,deathStartedAt:0,animationSerial:3};
+  const world=Object.create(CastleWorld.prototype);world.scene=new THREE.Scene();world.knightParts=templates;world.enemyDebris=new Map();world.gameplay={time:0};world.actorInstances=new Map([[object.id,actor]]);
+  world.instantiateActor=template=>{
+    const piece=new THREE.Group(),mesh=new THREE.Mesh(new THREE.BufferGeometry(),new THREE.MeshBasicMaterial());piece.add(mesh);
+    piece.userData={mesh,template:{...template,geometry:mesh.geometry}};return piece;
+  };
+  world.physicalModels=[];world.collider={trace:(_a,end)=>({fraction:1,end})};
+  world.createKnightDebris(object,actor);return {world,object,actor};
+}
+
+test('knight fragments restore actual positions, spin, contact history and fade without retracing history',()=>{
+  const {world,object,actor}=knightFixture();world.gameplay.time=.8;world.updateEnemyDebris(.8);
+  const original=world.enemyDebris.get(object.id);
+  const axe=original.parts.find(p=>p.particle.actor==='knax').particle;
+  axe.settled=true;axe.contacts=12;axe.fadeStartedAt=.4;axe.opacity=.8;axe.velocity=[0,0,0];
+  const saved=roundtrip(object.knightDebrisSnapshot());assert.equal(saved.particles.length,9);
+  const expected=restoreKnightDebrisState(saved);assert.ok(expected);
+  for(const part of original.parts)world.removeKnightDebrisPart(part);
+  let traces=0;world.collider.trace=(_a,end)=>{traces++;return{fraction:1,end};};
+  object.knightDebrisState=saved;world.createKnightDebris(object,actor);world.updateEnemyDebris(0);
+  assert.equal(traces,0,'no prior collisions replay against current doors or platforms');
+  assert.deepEqual(object.knightDebrisSnapshot(),saved);
+  world.gameplay.time+=.04;world.updateEnemyDebris(.04);
+  const step=world.gameplay.time-expected.age;
+  expected.age+=step;for(const p of expected.particles)stepNativeDebris(p,step,(_a,end)=>({fraction:1,end}));
+  assert.deepEqual(object.knightDebrisSnapshot(),expected);
+  for(const part of world.enemyDebris.get(object.id).parts)assert.deepEqual(part.actor.position.toArray(),part.particle.position);
+  const snapshot=object.knightDebrisSnapshot();snapshot.particles[0].position[0]+=5;
+  assert.notDeepEqual(snapshot,object.knightDebrisSnapshot());
+  world.gameplay.time=7;world.updateEnemyDebris(.05);assert.equal(object.knightDebrisSnapshot(),undefined);
+});
+
+test('legacy knight saves still replay once and malformed snapshots never create unbounded fragments',()=>{
+  const {world,object}=knightFixture();world.gameplay.time=.6;let traces=0;
+  world.collider.trace=(_a,end)=>{traces++;return{fraction:1,end};};world.updateEnemyDebris(0);
+  assert.ok(traces>0);const state=snapshotKnightDebrisState(world.enemyDebris.get(object.id));
+  for(const mutate of [s=>s.particles=Array(65).fill(s.particles[0]),s=>s.particles[0].actor='unknown',s=>s.particles[0].velocity[0]=Infinity,s=>s.life=1e6]){
+    const copy=structuredClone(state);mutate(copy);assert.equal(restoreKnightDebrisState(copy),undefined);
+  }
+});
