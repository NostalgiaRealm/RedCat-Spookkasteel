+  const localKey=(pose,index)=>{
+    const bone=pose.data.bones[index],matrix=boneMatrix(pose.animator.transforms[index]);
+    if(bone.parent>=0)matrix.premultiply(boneMatrix(pose.animator.transforms[bone.parent]).invert());
