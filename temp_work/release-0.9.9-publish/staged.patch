+  if(state.waitUntil===null){
+    state.waitUntil=(milliseconds(time)+Math.trunc(Math.max(0,seconds)*1000))/1000;
+    return false;
+  }
+  return milliseconds(time)>Math.round(state.waitUntil*1000);
