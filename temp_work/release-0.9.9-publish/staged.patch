+import {Vector3} from 'three';
+
+const FLAME='flame03.bmp|a_flame.bmp';
+const capVertices=[51,52,53],capCache=new WeakMap();
+const distance2=(a,b)=>a.reduce((sum,value,i)=>sum+(value-b[i])**2,0);
