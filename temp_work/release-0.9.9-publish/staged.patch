+    }
+    await ctx.close();return out;
+  });
+  assert.ok(Object.values(audioDurations).every(n=>n>0));
+  assert.deepEqual(errors,[]);assert.deepEqual(missing,[]);assert.deepEqual(consoleErrors,[]);
