diff --git a/android/app/src/test/java/com/nostalgiarealm/redcatspookkasteel/GameUrlsTest.kt b/android/app/src/test/java/com/nostalgiarealm/redcatspookkasteel/GameUrlsTest.kt
new file mode 100644
index 00000000..2657661e
--- /dev/null
+++ b/android/app/src/test/java/com/nostalgiarealm/redcatspookkasteel/GameUrlsTest.kt
@@ -0,0 +1,46 @@
+package com.nostalgiarealm.redcatspookkasteel
+
+import org.junit.Assert.*
+import org.junit.Test
+
+class GameUrlsTest {
+    @Test fun localFilesKeepDecodedSpacesAndRelativeLayout() {
+        assertEquals("www/assets/audio/level 3 - the graveyard.wav",
+            GameUrls.assetPath("${GameUrls.ORIGIN}/assets/www/assets/audio/level%203%20-%20the%20graveyard.wav"))
+        assertEquals("www/index.html", GameUrls.assetPath("${GameUrls.ENTRY}?skipIntro#menu"))
+        assertTrue(GameUrls.isGamePage(GameUrls.ENTRY))
+        assertFalse(GameUrls.isGamePage("${GameUrls.ORIGIN}/assets/www/src/main.js"))
+    }
+
+    @Test fun pathsCannotEscapeThePackagedGame() {
+        for (path in listOf("../secret", "www/../secret", "www/./index.html", "www//index.html",
+            "www/a\\secret", "www/file\u0000.js", "www/", "/www/index.html")) {
+            assertFalse(path, GameUrls.isSafeAssetPath(path))
+        }
+        for (path in listOf("/assets/www/%2e%2e/secret", "/assets/www/%2E/index.html",
+            "/assets/www/a%5C..%5Csecret", "/assets/www/%00hidden", "/assets/secret", "/other/www/index.html")) {
+            assertNull(path, GameUrls.assetPath(GameUrls.ORIGIN + path))
+        }
+    }
+
+    @Test fun trustIsLimitedToTheHttpsAppOrigin() {
+        assertTrue(GameUrls.isGameOrigin(GameUrls.ORIGIN))
+        assertTrue(GameUrls.isGameOrigin("${GameUrls.ORIGIN}:443"))
+        for (url in listOf("http://${GameUrls.HOST}", "${GameUrls.ORIGIN}:8443",
+            "https://${GameUrls.HOST}.example.com", "https://${GameUrls.HOST}@evil.example",
+            "file:///assets/www/index.html", "javascript:alert(1)", "not a url")) {
+            assertFalse(url, GameUrls.isGameOrigin(url))
+            assertNull(url, GameUrls.assetPath(url))
+        }
+    }
+
+    @Test fun onlyTheAboutDestinationsCanOpenExternally() {
+        assertTrue(GameUrls.isExternalLink("https://ko-fi.com/nostalgiarealm"))
+        assertTrue(GameUrls.isExternalLink("https://www.nostalgiarealm.com/"))
+        assertTrue(GameUrls.isExternalLink("https://github.com/NostalgiaRealm/RedCat-Spookkasteel"))
+        assertTrue(GameUrls.isExternalLink("https://www.youtube.com/@Nostalgia_Realm"))
+        assertFalse(GameUrls.isExternalLink("http://www.nostalgiarealm.com/"))
+        assertFalse(GameUrls.isExternalLink("https://www.nostalgiarealm.com.evil.example/"))
+        assertFalse(GameUrls.isExternalLink("intent://anything"))
+    }
+}
diff --git a/android/app/src/test/java/com/nostalgiarealm/redcatspookkasteel/HttpByteRangeTest.kt b/android/app/src/test/java/com/nostalgiarealm/redcatspookkasteel/HttpByteRangeTest.kt
new file mode 100644
index 00000000..f4ebcb9b
--- /dev/null
+++ b/android/app/src/test/java/com/nostalgiarealm/redcatspookkasteel/HttpByteRangeTest.kt
@@ -0,0 +1,58 @@
+package com.nostalgiarealm.redcatspookkasteel
+
+import java.io.ByteArrayInputStream
+import java.io.EOFException
+import org.junit.Assert.*
+import org.junit.Test
+
+class HttpByteRangeTest {
+    @Test fun supportsVideoSeekAndSuffixRequests() {
+        assertEquals(HttpByteRange(0, 99), HttpByteRange.parse("bytes=0-99", 1000))
+        assertEquals(HttpByteRange(100, 999), HttpByteRange.parse("bytes=100-", 1000))
+        assertEquals(HttpByteRange(900, 999), HttpByteRange.parse("bytes=-100", 1000))
+        assertEquals(HttpByteRange(0, 999), HttpByteRange.parse("bytes=-2000", 1000))
+        assertEquals(HttpByteRange(900, 999), HttpByteRange.parse("bytes=900-5000", 1000))
+        assertEquals(100L, HttpByteRange.parse("bytes=900-", 1000)?.length)
+    }
+
+    @Test fun rejectsMalformedOverflowingAndUnsatisfiableRanges() {
+        for (header in listOf("bytes=", "bytes=-", "bytes=-0", "bytes=1000-", "bytes=20-10",
+            "bytes=0-2,5-8", "items=0-5", "bytes=9999999999999999999999-", "bytes=0-9999999999999999999999")) {
+            assertNull(header, HttpByteRange.parse(header, 1000))
+        }
+        assertNull(HttpByteRange.parse("bytes=0-", 0))
+        assertNull(HttpByteRange.parse("bytes=0-", -1))
+    }
+
+    @Test fun streamNeverReturnsBytesAfterTheRangeBoundary() {
+        val source = ByteArrayInputStream("0123456789".toByteArray())
+        source.skipExactly(3)
+        LimitedInputStream(source, 4).use { stream ->
+            assertEquals('3'.code, stream.read())
+            assertEquals(3, stream.available())
+            assertEquals("456", stream.readBytes().toString(Charsets.UTF_8))
+            assertEquals(-1, stream.read())
+            assertEquals(0, stream.read(ByteArray(0), 0, 0))
+        }
+    }
+
+    @Test fun skippingCannotCrossTheRangeBoundary() {
+        LimitedInputStream(ByteArrayInputStream(ByteArray(20)), 5).use { stream ->
+            assertEquals(5L, stream.skip(100))
+            assertEquals(0L, stream.skip(1))
+            assertEquals(-1, stream.read())
+        }
+    }
+
+    @Test fun skipExactlyHandlesStreamsThatDoNotSupportSkip() {
+        val input = object : ByteArrayInputStream("0123".toByteArray()) {
+            override fun skip(count: Long) = 0L
+        }
+        input.skipExactly(3)
+        assertEquals('3'.code, input.read())
+    }
+
+    @Test(expected = EOFException::class) fun skipExactlyRejectsTruncatedFiles() {
+        ByteArrayInputStream(byteArrayOf(1, 2)).skipExactly(3)
+    }
+}
