+export const ENEMY_PORTRAITS={bat:0,ghost:3,spider:6,brutusm:9,brutusb:9,maxj:10,maxd:11,skeleton:12,zombie:13,guardian:15,knight:14,witch:16,gargoyle:17,frog:18,plant:19};
