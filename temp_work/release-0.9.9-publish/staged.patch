+.panel{max-height:calc(100dvh - 32px);overflow:auto}.fields{display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:10px;text-align:left;align-items:center;margin:20px 0}.fields select{font:inherit;min-width:0;max-width:100%;padding:10px;border:1px solid #778b98;border-radius:4px;color:#fff;background:#233b48}.loop{display:block;text-align:left;margin:15px 0}.actions{display:flex;justify-content:center;gap:12px;flex-wrap:wrap}footer .controls{margin-top:8px}#inspect{margin-left:auto}button{padding:10px 16px}@media(max-width:600px){.fields{grid-template-columns:minmax(0,1fr)}footer{flex-wrap:wrap}.panel{padding:16px}.note{margin:12px 0 0}}
