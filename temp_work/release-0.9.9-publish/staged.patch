+    if(numeric(e.Type)!==3) {
+      object.beamContactDelay=Math.max(0,numeric(e.TriggerDelay));
+      if(!object.beamContactDelay)game.runEvent(object,'CommandOnEnter');
+    }
+    if(game.state.lives!==lives||game.state.health<=0)return;
+  }
+}
