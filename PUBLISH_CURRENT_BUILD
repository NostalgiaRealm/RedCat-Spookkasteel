Check exactly what will be uploaded:
git status
git diff --cached --stat
git diff --cached

Then commit it:
git commit -m "Release 0.9.9"

Sync against GitHub before pushing:
git pull (if there were any changes on GitHub only)
git rebase origin/main

Then push:
git push -u origin main

Create an annotated tag for the commit you just pushed:
git tag -a v0.9.9 -m "RedCat Spookkasteel 0.9.9"
git push origin v0.9.9

Then create the release and upload both binaries plus the checksums:
gh release create v0.9.9 \
  dist/RedCat-Spookkasteel-0.9.9-windows-x64.zip \
  dist/RedCat-Spookkasteel-0.9.9-linux-x64.zip \
  dist/RedCat-Spookkasteel-0.9.9-linux-arm64.zip \
  dist/RedCat-Spookkasteel-0.9.9-windows-arm64.zip \
  dist/RedCat-Spookkasteel-0.9.9-mac-arm64.zip \
  dist/RedCat-Spookkasteel-0.9.9-mac-x64.zip \
  dist/SHA256SUMS.txt \
  --repo NostalgiaRealm/RedCat-Spookkasteel \
  --title "RedCat Spookkasteel 0.9.9" \
  --generate-notes \
  --notes-file ./RELEASE_NOTES

