{
  "name": "redcat-spookkasteel-recompiled",
  "version": "2.0.1",
  "private": true,
  "type": "module",
  "description": "RedCat Spookkasteel in the browser: the original game module RcHcGame.dat recompiled from x86 to WebAssembly.",
  "main": "electron/main.cjs",
  "scripts": {
    "recompile": "$HOME/.local/share/reverse-engineering/python-analysis/bin/python -I tools/recomp/build.py --out public/game",
    "preload": "node tools/build-preload.mjs",
    "package": "node tools/package.mjs",
    "package:check": "node tools/package-check.mjs",
    "site:check": "node tools/site-check.mjs",
    "headless": "node tools/run-headless.mjs",
    "build:desktop": "node tools/package-desktop.mjs",
    "desktop:check": "node tools/desktop-check.mjs",
    "build:android": "node tools/build-android.mjs",
    "build:android:debug": "node tools/build-android.mjs --debug",
    "android:check": "node tools/android-check.mjs"
  }
}
